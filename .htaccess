# ==============================================================================
#  ANCAMAN CYBER DEFENSE — SECURE & OPTIMIZED .HTACCESS (LITESPEED / APACHE)
# ==============================================================================

# 1. Matikan Directory Browsing (Mencegah pengunjung melihat isi folder downloads secara langsung)
Options -Indexes

# 2. Paksa Semua Koneksi ke HTTPS (SSL Aman Otomatis)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. Header Keamanan Siber Standar Industri
<IfModule mod_headers.c>
    # Cegah situs disematkan di iframe orang lain (Anti-Clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Cegah browser menebak-nebak tipe file (Anti-MIME-Sniffing)
    Header always set X-Content-Type-Options "nosniff"
    
    # Perlindungan XSS bawaan browser
    Header always set X-XSS-Protection "1; mode=block"
    
    # Kebijakan Referrer yang aman
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Optimasi Kecepatan & Kompresi (Gzip / Brotli)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Cache Browser untuk Aset Statis (Membuat Web Sangat Cepat Terbuka)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/zip "access plus 1 week"
</IfModule>

# 6. Alihkan Halaman 404 Kembali ke Beranda
ErrorDocument 404 /index.html
